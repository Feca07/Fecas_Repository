simular_avion <- function() {
n <- 100
asientos <- rep(0, n)  # 0 = libre, i = ocupado por persona i
# Persona 1: elige asiento aleatorio
asientos[sample(1:n, 1)] <- 1
ocupados_incorrectamente <- 0
for (i in 2:n) {
if (asientos[i] == 0) {
# Su asiento está libre → se sienta
asientos[i] <- i
} else {
# Su asiento está ocupado → elige uno libre al azar
ocupados_incorrectamente <- ocupados_incorrectamente + 1
libres <- which(asientos == 0)
asientos[sample(libres, 1)] <- i
}
}
# ¿La persona 100 está en su asiento (asiento 100)?
ultimo_en_su_sitio <- (asientos[100] == 100)
return(list(
ultimo_correcto = ultimo_en_su_sitio,
desplazados = ocupados_incorrectamente
))
}
simular_avion()
set.seed(155)
N <- 10000  # número de réplicas
resultados <- replicate(N, simular_avion(), simplify = FALSE)
ultimo_correcto <- sapply(resultados, function(x) x$ultimo_correcto)
desplazados     <- sapply(resultados, function(x) x$desplazados)
# Apartado a: P(último pasajero en su asiento)
cat("P(último en su asiento):", mean(ultimo_correcto), "\n")
# Apartado b: E y Var del número de personas desplazadas
cat("E[desplazados]:", mean(desplazados), "\n")
cat("Var[desplazados]:", var(desplazados), "\n")
