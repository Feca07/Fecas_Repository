set.seed(57)
rexp.custom= function(lambda){
return (-log(runif(1))/lambda)
}
c= 1.28
rnorm.custom3= function(c){
y=rexp.custom(1)
u=runif(1)
f=sqrt(2/pi)*exp((-y^2)/2)
g=exp(-y)
if(u<= (f/(c*g))){
return(y)
}
else {return(NA)}
}
set.seed(57)
mednorm=replicate(1000,rnorm.custom3(c=c))
summary(mednorm)
B=1000
x=NULL
c= 1.28
for (i in 1:B){
y=rexp.custom(1)
u=runif(1)
f=sqrt(2/pi)*exp((-y^2)/2)
g=exp(-y)
if(u<= (f/(c*g))){
x[i]=y
}
else x[i]=NA
}
microbenchmark()
