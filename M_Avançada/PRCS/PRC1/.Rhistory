set.seed(123) # Per reproductibilitat
n <- nrow(credit)
train_indices <- sample(1:n, size = 0.7 * n)
train_set <- credit[train_indices, ]
test_set  <- credit[-train_indices, ]
model_svm <- svm(default.payment.next.month ~ .,
data = train_set,
kernel = "radial",
cost = 1,
scale = TRUE)
pred_svm <- predict(model_svm, test_set)
# Mètriques de comportament: Matriu de Confusió
taula_svm <- table(Prediccio = pred_svm, Realitat = test_set$default.payment.next.month)
print(taula_svm)
metric <- function(table){
# Càlcul de l'Accuracy (Precisió Global)
accuracy <- sum(diag(table))/sum(table)
# Càlcul de mètriques
TP <- table[2, 2] # True Positives
TN <- table[1, 1] # True Negatives
FP <- table[2, 1] # False Positives
FN <- table[1, 2] # False Negatives
# Sensitivity (True Positive Rate)
sensitivity <- TP/(TP + FN)
# Specificity (True Negative Rate)
specificity <- TN/(TN + FP)
# Balanced Accuracy
balanced_acc <- (sensitivity + specificity)/2
# F1
precision <- TP/(TP + FP)
f1 <- 2 * (precision * sensitivity)/(precision +
sensitivity)
# MCC
mcc <- (TP*TN - FP*FN) / sqrt(as.numeric(TP+FP)*(TP+FN)*(TN+FP)*(TN+FN))
# Mostrar resultats
cat("Accuracy:", round(accuracy, 4),"\n")
cat("Sensitivity (TPR):", round(sensitivity, 4), "\n")
cat("Specificity (TNR):", round(specificity, 4), "\n")
cat("Balanced Accuracy:", round(balanced_acc, 4), "\n")
cat("F1 Score:", round(f1, 4), "\n")
cat("MCC:", round(mcc, 4), "\n")
invisible(list(
acc = accuracy,
sens = sensitivity,
spec = specificity,
bal_acc = balanced_acc,
f1 = f1,
mcc = mcc))
}
res_svm <- metric(taula_svm)
vars_num <- sapply(credit, is.numeric)
X_train_raw <- train_set[, vars_num]
X_test_raw  <- test_set[, vars_num]
target_name <- "default.payment.next.month"
if(target_name %in% colnames(X_train_raw)) {
X_train_raw <- X_train_raw[, !colnames(X_train_raw) %in% target_name]
X_test_raw  <- X_test_raw[, !colnames(X_test_raw) %in% target_name]
}
X_train <- scale(X_train_raw)
train_center <- attr(X_train, "scaled:center")
train_scale  <- attr(X_train, "scaled:scale")
X_test <- scale(X_test_raw, center = train_center, scale = train_scale)
y_train <- train_set$default.payment.next.month
y_test  <- test_set$default.payment.next.month
k_values_wide <- seq(5, 500, by = 20)
auc_values_wide <- numeric(length(k_values_wide))
set.seed(123)
j <- 1
for (i in k_values_wide) {
pred_knn <- knn(train = X_train,
test = X_test,
cl = y_train,
k = i,
prob = TRUE)
prob_ganadora <- attr(pred_knn, "prob")
probs_clase_1 <- ifelse(pred_knn == "Default", prob_ganadora, 1 - prob_ganadora)
roc_obj <- roc(y_test, probs_clase_1, quiet = TRUE)
auc_values_wide[j] <- auc(roc_obj)
j <- j + 1
}
par(
mar = c(4, 4, 1, 1),
cex = 0.8
)
plot(k_values_wide, auc_values_wide,
type = "b", pch = 19, col = "purple",
xlab = "Valor de K", ylab = "AUC",
main = "Buscant el límit de l'AUC (K fins 500)")
grid()
k_values <- seq(1, 201, by = 20)
acc_custom <- numeric(length(k_values))
bal_acc_custom <- numeric(length(k_values))
llindar <- 0.25
set.seed(123)
for (j in 1:length(k_values)) {
k_val <- k_values[j]
pred_knn <- knn(train = X_train,
test = X_test,
cl = y_train,
k = k_val,
prob = TRUE)
prob_guanyadora <- attr(pred_knn, "prob")
probs_default <- ifelse(pred_knn == "Default", prob_guanyadora, 1 - prob_guanyadora)
pred_ajustada <- ifelse(probs_default > llindar, "Default", "No Default")
pred_ajustada <- factor(pred_ajustada, levels = levels(y_test))
taula <- table(Prediccio = pred_ajustada, Realitat = y_test)
acc_custom[j] <- sum(diag(taula)) / sum(taula)
sensibilitat <- taula[2, 2] / sum(taula[, 2])
especificitat <- taula[1, 1] / sum(taula[, 1])
bal_acc_custom[j] <- (sensibilitat + especificitat) / 2
}
par(
mfrow = c(1, 2),
mar = c(4, 4, 2, 1),
cex = 0.8
)
# Gràfic 1: Accuracy Global
plot(k_values, acc_custom,
type = "b", pch = 19, col = "blue",
xlab = "Valor de K",
ylab = "Exactitud (Accuracy)",
main = paste0("Exactitud Global (Llindar ", llindar, ")"),
ylim = c(0.7, 0.9)) # Ajusta límits si cal
grid()
# Gràfic 2: Accuracy Balancejat
plot(k_values, bal_acc_custom,
type = "b", pch = 19, col = "darkgreen",
xlab = "Valor de K",
ylab = "Exactitud Balancejada",
main = paste0("Exactitud Balancejada (Llindar ", llindar, ")"),
ylim = c(0.6, 0.8)) # Ajusta límits si cal
grid()
par(mfrow = c(1, 1))
millor_idx <- which.max(bal_acc_custom)
cat("\n--- RESULTATS FINALS ---\n")
cat("Millor K:", k_values[millor_idx], "\n")
cat("Exactitud Global aconseguida:", round(acc_custom[millor_idx], 4), "\n")
cat("Exactitud Balancejada aconseguida:", round(bal_acc_custom[millor_idx], 4), "\n")
pred_knn_prob <- knn(train = X_train,
test = X_test,
cl = y_train,
k = 201,
prob = TRUE)
prob_ganadora <- attr(pred_knn_prob, "prob")
