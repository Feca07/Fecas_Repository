tree_model <- rpart(default.payment.next.month ~ .,
data = train_set,
method = "class")
# Pruning
cp_opt <- tree_model$cptable[which.min(tree_model$cptable[,"xerror"]), "CP"]
tree_fin <- prune(tree_model, cp = cp_opt)
# Visualització
rpart.plot(tree_fin,extra = 104, box.palette = "RdBu", shadow.col = "gray")
title(
"Árbol de Decisión Podado (CART)",
line = 0.5
)
# Predicció
pred_dt <- predict(tree_fin, newdata = test_set, type = "class")
# Evaluació i mètriques
table_dt <- table(Prediccio = pred_dt, Realitat = test_set$default.payment.next.month)
print(table_dt)
res_dt <- metric(table_dt)
cat("\nCP óptimo seleccionado:", cp_opt)
