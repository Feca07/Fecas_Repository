# =========================
# 0) Paquetes
# =========================
pkgs <- c("quantmod", "xts", "PerformanceAnalytics", "tseries",
"rugarch", "ggplot2")
to_install <- pkgs[!pkgs %in% installed.packages()[, "Package"]]
if(length(to_install)) install.packages(to_install)
library(quantmod)
library(xts)
library(PerformanceAnalytics)
library(tseries)
library(rugarch)
library(ggplot2)
# =========================
# 1) Datos: PLUG (horizonte recomendado)
#    Para "intentar predecir" suele ser razonable usar ~5-10 años.
#    Aquí: 10 años para tener más información de volatilidad.
# =========================
symbol <- "PLUG"
from_date <- Sys.Date() - 365*10
getSymbols(symbol, src = "yahoo", from = from_date, auto.assign = TRUE)
x <- get(symbol)
x
x
# Precios ajustados (recomendado para análisis de serie de precio por splits/dividendos)
p <- Ad(x)
colnames(p) <- "Adj"
# =========================
# 2) Descriptivo sobre PRECIOS
# =========================
# Gráfico de precios
chartSeries(p, name = paste0(symbol, " - Adjusted Close"), theme = chartTheme("white"))
# Resumen básico
print(summary(p))
cat("\nNAs en precios:", sum(is.na(p)), "\n")
# Drawdown (sobre precios ajustados)
chart.Drawdown(p, main = paste0(symbol, " - Drawdowns (sobre precio ajustado)"))
# =========================
# 3) Rendimientos (necesarios para GARCH)
# =========================
r <- dailyReturn(p, type = "log")   # log-rendimientos diarios
r <- na.omit(r)
colnames(r) <- "r"
# Visual: rendimientos
chartSeries(r, name = paste0(symbol, " - Log returns"), theme = chartTheme("white"))
# Estadísticos descriptivos de rendimientos
print(table.Stats(r))
chart.Histogram(r, methods = c("add.density", "add.normal"),
main = paste0(symbol, " - Histograma de log-rendimientos"))
# ACF/PACF de rendimientos (media) y de rendimientos^2 (volatilidad)
par(mfrow = c(2,2))
acf(coredata(r), main = "ACF(r)")
pacf(coredata(r), main = "PACF(r)")
acf(coredata(r^2), main = "ACF(r^2)")
pacf(coredata(r^2), main = "PACF(r^2)")
par(mfrow = c(1,1))
# Tests típicos (orientativos)
# Normalidad (suele rechazarse)
print(tseries::jarque.bera.test(coredata(r)))
# Efectos ARCH: si hay heterocedasticidad condicional, apoya uso de GARCH
print(FinTS::ArchTest(coredata(r), lags = 12))  # requiere FinTS
install.packages("FinTS")
install.packages("FinTS")
library(FinTS)
# =========================
# 4) Especificación GARCH
# =========================
spec <- ugarchspec(
variance.model = list(model = "sGARCH", garchOrder = c(1,1)),
mean.model     = list(armaOrder = c(0,0), include.mean = TRUE),
distribution.model = "std"  # t-Student (suele encajar mejor que normal)
)
fit <- ugarchfit(spec = spec, data = r)
show(fit)
# =========================
# 5) Diagnóstico del ajuste
# =========================
# Residuos estandarizados
z <- residuals(fit, standardize = TRUE)
par(mfrow = c(2,2))
plot(z, main = "Residuos estandarizados", type = "l")
acf(z, main = "ACF(z)")
acf(z^2, main = "ACF(z^2)")
qqnorm(z); qqline(z, col = "red")
par(mfrow = c(1,1))
# =========================
# 6) Volatilidad condicional estimada
# =========================
sigma_t <- sigma(fit)
plot(sigma_t, main = paste0(symbol, " - Volatilidad condicional (sigma)"), type = "l")
# =========================
# 6) Volatilidad condicional estimada
# =========================
sigma_t <- sigma(fit)
plot(sigma_t, main = paste0(symbol, " - Volatilidad condicional (sigma)"), type = "l")
# Pronóstico 20 días
fc <- ugarchforecast(fit, n.ahead = 20)
sigma_fc <- sigma(fc)
mu_fc <- fitted(fc)
sigma_fc
mu_fc
precio <- Ad(PLUG) # Precio Ajustado
rendimientos <- diff(log(precio))[-1] # Log-rendimientos (r_t
# Gráfico de rendimientos
plot(rendimientos, main = "Log-rendimientos de PLUG")
# Identificación (Acf y Pacf)
Acf(rendimientos, main = "ACF Rendimientos")
Pacf(rendimientos, main = "PACF Rendimientos")
# Si hay autocorrelación, ajustaríamos un ARIMA.
# Si no, usamos la media:
modelo_media <- Arima(rendimientos, order = c(0,0,0))
residuos <- residuals(modelo_media)
# Si hay autocorrelación, ajustaríamos un ARIMA.
# Si no, usamos la media:
modelo_media <- arima(rendimientos, order = c(0,0,0))
residuos <- residuals(modelo_media)
# Análisis de residuos al cuadrado
residuos_sq <- residuos^2
Acf(residuos_sq, main = "ACF de Residuos al Cuadrado (Efecto ARCH)")
# Test de Ljung-Box sobre residuos al cuadrado
# H0: No hay efectos ARCH
Box.test(residuos_sq, lag = 10, type = "Ljung-Box")
modelo_garch_simple <- garch(rendimientos, order = c(1, 1))
summary(modelo_garch_simple)
# Para ver la volatilidad estimada:
plot(fitted(modelo_garch_simple)[,1], type = "l", main = "Volatilidad Condicional")
# Especificación: GARCH(1,1) con distribución t-student (para capturar colas pesadas)
especificacion <- ugarchspec(
variance.model = list(model = "sGARCH", garchOrder = c(1, 1)),
mean.model = list(armaOrder = c(0, 0), include.mean = TRUE),
distribution.model = "std"
)
ajuste_garch <- ugarchfit(spec = especificacion, data = rendimientos)
print(ajuste_garch)
# Gráfico de la volatilidad (Sigma)
plot(ajuste_garch, which = 3)
prediccion <- ugarchforecast(ajuste_garch, n.ahead = 10)
print(prediccion)
# Gráfico de la predicción de volatilidad
plot(prediccion, which = 3)
prediccion <- ugarchforecast(ajuste_garch, n.ahead = 20)
print(prediccion)
# Gráfico de la predicción de volatilidad
plot(prediccion, which = 3)
prediccion <- ugarchforecast(ajuste_garch, n.ahead = 200)
print(prediccion)
# Gráfico de la predicción de volatilidad
plot(prediccion, which = 3)
prediccion <- ugarchforecast(ajuste_garch, n.ahead = 10)
print(prediccion)
# Gráfico de la predicción de volatilidad
plot(prediccion, which = 3)
